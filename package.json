{
  "name": "mcp-commander-console",
  "version": "1.0.0",
  "description": "Production-ready MCP server with a cinematic ops dashboard — dual-interface (stdio + HTTP), 13 dev/system tools, Docker-scale observability with Grafana & Prometheus.",
  "main": "server.js",
  "type": "module",
  "bin": {
    "mcp-commander-console": "bin/mcp-commander-console.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacobcdsmith/MCP-Commander-Console.git"
  },
  "homepage": "https://github.com/Jacobcdsmith/MCP-Commander-Console#readme",
  "bugs": {
    "url": "https://github.com/Jacobcdsmith/MCP-Commander-Console/issues"
  },
  "author": {
    "name": "Jacobcdsmith",
    "url": "https://github.com/Jacobcdsmith"
  },
  "files": [
    "server.js",
    "bin",
    "dashboard.html",
    "mcp-console.html",
    "pages",
    "promo/index.html",
    "promo/og-card.jpg",
    "promo/promo-trailer.mp4",
    "promo/screenshots",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "DEBUG=1 node server.js",
    "debug": "node --inspect-brk server.js",
    "debug-dev": "DEBUG=1 node --inspect-brk server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext .js,.json",
    "lint:fix": "eslint . --ext .js,.json --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules package-lock.json && npm install",
    "audit:fix": "npm audit fix",
    "precommit": "npm run lint && npm run format:check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "ai-agent",
    "dev-tools",
    "devtools",
    "system-monitoring",
    "dashboard",
    "docker",
    "observability",
    "grafana",
    "prometheus",
    "automation",
    "cli"
  ],
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "cors": "^2.8.5",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "p-limit": "^6.2.0",
    "p-retry": "^6.2.1",
    "zod": "^3.25.76",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
